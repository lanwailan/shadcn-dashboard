{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.internal/schemas/dataset.schema.json",
  "title": "Insight Studio Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "version",
    "owner",
    "source",
    "updatedAt",
    "refresh",
    "cacheTtl",
    "permission",
    "fields",
    "rows",
    "lineage"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "owner": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string" },
    "refresh": { "type": "string" },
    "cacheTtl": { "type": "string" },
    "permission": { "type": "string" },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": ["string", "number", "boolean", "null"]
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "role", "description"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "number", "datetime", "boolean"] },
        "role": { "enum": ["dimension", "metric", "time"] },
        "description": { "type": "string" }
      }
    }
  }
}
