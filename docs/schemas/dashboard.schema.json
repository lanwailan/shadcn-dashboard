{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.internal/schemas/dashboard.schema.json",
  "title": "Insight Studio Dashboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "status",
    "updatedAt",
    "layout",
    "widgets"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": { "enum": ["draft", "published"] },
    "updatedAt": { "type": "string" },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rowHeight", "gap"],
      "properties": {
        "columns": { "const": 24 },
        "rowHeight": { "type": "number", "exclusiveMinimum": 0 },
        "gap": { "type": "number", "minimum": 0 }
      }
    },
    "widgets": {
      "type": "array",
      "items": { "$ref": "#/$defs/widget" }
    }
  },
  "$defs": {
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "dataset",
        "title",
        "position",
        "mapping"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": {
          "enum": [
            "metric",
            "barChart",
            "lineChart",
            "pieChart",
            "table",
            "progress",
            "statusList",
            "markdown"
          ]
        },
        "dataset": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "integer", "minimum": 0, "maximum": 23 },
            "y": { "type": "integer", "minimum": 0 },
            "w": { "type": "integer", "minimum": 1, "maximum": 24 },
            "h": { "type": "integer", "minimum": 1 }
          }
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string" },
            "category": { "type": "string" },
            "series": { "type": "string" },
            "time": { "type": "string" },
            "columns": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "filters": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "type": "string" },
            "aggregate": { "enum": ["sum", "avg", "count", "max"] },
            "unit": { "type": "string" },
            "precision": { "type": "integer", "minimum": 0, "maximum": 10 },
            "description": { "type": "string" }
          }
        }
      }
    }
  }
}
