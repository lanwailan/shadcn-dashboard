{
  "id": "jira_test_cases",
  "name": "Jira CICT Test Cases",
  "connector": "jira",
  "config": {
    "endpoint": "https://jira.example.com",
    "jql": "project = CICT AND type = Test",
    "authRef": "jira-prod-token",
    "transformRef": "normalize_test_cases_v1"
  },
  "owner": "测试平台组",
  "syncMode": "incremental",
  "schedule": "*/10 * * * *",
  "cursorField": "updatedAt",
  "outputDataset": "test_case_status"
}
